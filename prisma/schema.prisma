// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DB_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id       String @id @default(cuid())
  password String
  email    String @unique

  user User?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("accounts")
}

model User {
  id       String @default(cuid())
  username String @id @unique
  name     String

  photo Image?

  accountkey String  @unique
  account    Account @relation(fields: [accountkey], references: [id], onDelete: Cascade)

  comments        Comment[]
  notifications   Notification[]
  participates_in Affiliation[]
  audit_logs      AuditLog[]

  organization Organization? @relation("OrgOwner")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("users")
}

model Organization {
  id   String @id @default(cuid())
  name String

  ownerkey String @unique
  owner    User   @relation("OrgOwner", fields: [ownerkey], references: [username])

  projects Project[]
  members  Affiliation[]
  audit_logs AuditLog[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("organizations")
}

model Affiliation {
  id String @id @default(cuid())

  orgkey String
  org    Organization @relation(fields: [orgkey], references: [id])

  role OrgRole @default(MEMBER)

  userkey String
  user    User   @relation(fields: [userkey], references: [username])

  member_in Member[]
  manage    Project[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([userkey, orgkey])
  @@map("affiliations")
}

model Image {
  id       String @id @default(cuid())
  filename String
  url      String

  userkey String @unique
  user    User   @relation(fields: [userkey], references: [username])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("images")
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String
  deadline    DateTime @map("due_date")
  started_at  DateTime?
  done_at     DateTime?
  delayed     Boolean  @default(false)

  stage ProjectStage @default(STARTED) @map("progress")

  ownerkey String
  owner    Organization @relation(fields: [ownerkey], references: [id])

  managerkey String?
  manager    Affiliation? @relation(fields: [managerkey], references: [id])

  members         Member[]
  comments        Comment[]
  tasks           Task[]
  events          Event[]
  work_logs       TaskWorkLog[]
  stats_snapshots ProjectStatsPeriodSnapshot[]
  stats_reports    ProjectStatsReport[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([delayed, deadline, stage])
  @@map("projects")
}

model Member {
  id String @id @default(cuid())

  projectkey String
  project    Project @relation(fields: [projectkey], references: [id], onDelete: Cascade)

  userkey String
  user    Affiliation @relation(fields: [userkey], references: [id], onDelete: Cascade)

  tasks          Task[]
  work_logs      TaskWorkLog[]
  period_entries ProjectStatsPeriodTask[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("member")
}

model Task {
  id   String @id @unique @default(cuid())
  code String @unique

  name        String
  description String
  deadline    DateTime @map("due_date")
  started_at  DateTime?
  done_at     DateTime?
  delayed     Boolean  @default(false)

  stage    TaskStage    @default(PENDING)
  priority TaskPriority

  projectkey String
  project    Project @relation(fields: [projectkey], references: [id], onDelete: Cascade)

  ownerkey String
  owner    Member @relation(fields: [ownerkey], references: [id])

  work_logs      TaskWorkLog[]
  period_entries ProjectStatsPeriodTask[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([delayed, deadline, stage])
  @@map("tasks")
}

model Comment {
  id String @id @default(cuid())

  content String
  date    DateTime @default(now())

  ownerkey String
  owner    User   @relation(fields: [ownerkey], references: [username])

  projectkey String
  project    Project @relation(fields: [projectkey], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("comments")
}

model Event {
  id    String   @id @unique @default(cuid())
  title String
  date  DateTime

  projectkey String
  project    Project @relation(fields: [projectkey], references: [id])

  category EventCategory

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("events")
}

model TaskWorkLog {
  id String @id @default(cuid())

  projectkey String
  project    Project @relation(fields: [projectkey], references: [id], onDelete: Cascade)

  taskkey String
  task    Task @relation(fields: [taskkey], references: [id], onDelete: Cascade)

  memberkey String
  member    Member @relation(fields: [memberkey], references: [id], onDelete: Cascade)

  minutes   Int
  logged_at DateTime
  note      String?
  source    String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([projectkey, logged_at])
  @@index([taskkey, logged_at])
  @@index([memberkey, logged_at])
  @@map("task_work_logs")
}

model ProjectStatsPeriodSnapshot {
  id String @id @default(cuid())

  projectkey String
  project    Project @relation(fields: [projectkey], references: [id], onDelete: Cascade)

  period_type StatsPeriodType
  period_start DateTime
  period_end DateTime
  generated_at DateTime @default(now())
  cutoff_at DateTime

  performance_per_member_json Json
  productivity_json           Json
  summary_json                Json

  health_status ProjectHealthStatus
  health_score  Int

  period_tasks ProjectStatsPeriodTask[]
  reports      ProjectStatsReport[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([projectkey, period_type, period_start, cutoff_at])
  @@index([projectkey, period_type, period_start, period_end])
  @@map("project_stats_period_snapshots")
}

model ProjectStatsPeriodTask {
  id String @id @default(cuid())

  snapshotkey String
  snapshot    ProjectStatsPeriodSnapshot @relation(fields: [snapshotkey], references: [id], onDelete: Cascade)

  taskkey String
  task    Task @relation(fields: [taskkey], references: [id], onDelete: Cascade)

  memberkey String
  member    Member @relation(fields: [memberkey], references: [id], onDelete: Cascade)

  spent_minutes Int
  started_at    DateTime?
  done_at       DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([snapshotkey, taskkey, memberkey])
  @@index([snapshotkey])
  @@index([taskkey])
  @@index([memberkey])
  @@map("project_stats_period_tasks")
}

model ProjectStatsReport {
  id String @id @default(cuid())

  projectkey String
  project    Project @relation(fields: [projectkey], references: [id], onDelete: Cascade)

  generated_at DateTime @default(now())
  cutoff_at    DateTime
  period_type   StatsPeriodType

  snapshotkey String?
  snapshot    ProjectStatsPeriodSnapshot? @relation(fields: [snapshotkey], references: [id], onDelete: SetNull)

  file_url    String?
  payload_json Json?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([projectkey, generated_at])
  @@index([projectkey, cutoff_at])
  @@map("project_stats_reports")
}

model Notification {
  id String @id @default(cuid())

  action String

  actorkey String
  actor    User   @relation(fields: [actorkey], references: [username])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("notifications")
}

model AuditLog {
  id String @id @default(cuid())

  orgkey String
  org    Organization @relation(fields: [orgkey], references: [id], onDelete: Cascade)

  actorkey String?
  actor    User?   @relation(fields: [actorkey], references: [username], onDelete: SetNull)

  actorType AuditActorType
  action    AuditAction
  resource  AuditResource

  resourcekey String?
  changes     Json    @default("{}") @db.JsonB

  created_at DateTime @default(now())

  @@index([orgkey, created_at])
  @@index([actorkey])
  @@index([resource, resourcekey])
  @@map("audit_logs")
}

enum ProjectStage {
  STARTED
  PENDING
  IN_PROGRESS
  PAUSED
  COMPLETED
}

enum EventCategory {
  RELEASE
  MEETING
  REVIEW
  PLANNING
  TESTS
  LAUNCH
}

enum OrgRole {
  OWNER
  MANAGER
  MEMBER
}

enum TaskStage {
  STARTED
  PENDING
  IN_PROGRESS
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  EXTREME
}

enum StatsPeriodType {
  WEEK
  MONTH
  QUARTER
}

enum ProjectHealthStatus {
  SAFE
  WARNING
  CRITICAL
}

enum AuditActorType {
  USER
  SYSTEM
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ADD
  REMOVE
  COMMENT
  STATUS_CHANGE
  SYSTEM_UPDATE
}

enum AuditResource {
  ORGS
  AFFILIATIONS
  PROJECTS
  MEMBERS
  TASKS
  COMMENTS
  EVENTS
  PROJECT_STATS
}
