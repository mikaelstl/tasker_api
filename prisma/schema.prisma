model AuditLog {
  id String @id @default(cuid())

  orgkey String?
  org    Organization? @relation(fields: [orgkey], references: [id], onDelete: SetNull)

  actorkey String?
  actor    User?   @relation(fields: [actorkey], references: [username], onDelete: SetNull)

  actorType AuditActorType
  action    AuditAction
  resource  AuditResource

  resourcekey String?
  changes     Json    @default("{}") @db.JsonB

  created_at DateTime @default(now())

  @@index([orgkey, created_at])
  @@index([actorkey])
  @@index([resource, resourcekey])
  @@map("audit_logs")
}

enum ProjectStage {
  STARTED
  PENDING
  IN_PROGRESS
  PAUSED
  COMPLETED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  EXTREME
}

enum EventCategory {
  RELEASE
  MEETING
  REVIEW
  PLANNING
  TESTS
  LAUNCH
}

enum OrgRole {
  OWNER
  MANAGER
  MEMBER
}

enum TaskStage {
  STARTED
  PENDING
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  EXTREME
}

enum StatsPeriodType {
  WEEK
  MONTH
  QUARTER
}

enum ProjectHealthStatus {
  SAFE
  WARNING
  CRITICAL
}

enum AuditActorType {
  USER
  SYSTEM
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ADD
  REMOVE
  COMMENT
  STATUS_CHANGE
  SYSTEM_UPDATE
}

enum AuditResource {
  ORGS
  AFFILIATIONS
  PROJECTS
  MEMBERS
  TASKS
  COMMENTS
  EVENTS
  PROJECT_STATS
}
