// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DB_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id       String @id @default(cuid())
  password String
  email    String @unique

  user User?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("accounts")
}

model User {
  id       String @default(cuid())
  username String @id @unique
  name     String

  photo Image?

  accountkey String  @unique
  account    Account @relation(fields: [accountkey], references: [id], onDelete: Cascade)

  // notifications   Notification[]
  participates_in Affiliation[]
  audit_logs      AuditLog[]

  organizations Organization[] @relation("OrgOwner")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("users")
}

model Organization {
  id   String @id @default(cuid())
  name String

  ownerkey String
  owner    User   @relation("OrgOwner", fields: [ownerkey], references: [username], onDelete: Restrict)

  projects   Project[]
  members    Affiliation[]
  audit_logs AuditLog[]
  invites    OrganizationInvite[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("organizations")
}

model OrganizationInvite {
  id        String @id @default(cuid())
  tokenHash String @unique @map("token_hash") @db.Char(64)

  orgkey String
  org    Organization @relation(fields: [orgkey], references: [id], onDelete: Cascade)

  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  rejectedAt DateTime? @map("rejected_at")
  rejectedBy String?   @map("rejected_by")
  revokedAt  DateTime? @map("revoked_at")

  created_at DateTime @default(now())

  @@index([orgkey, created_at])
  @@index([expiresAt])
  @@map("organization_invites")
}

model Affiliation {
  id String @id @default(cuid())

  orgkey String
  org    Organization @relation(fields: [orgkey], references: [id], onDelete: Cascade)

  role OrgRole @default(MEMBER)

  userkey String
  user    User   @relation(fields: [userkey], references: [username], onDelete: Cascade)

  member_in Member[]
  manage    Project[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([userkey, orgkey])
  @@map("affiliations")
}

model Image {
  id       String @id @default(cuid())
  filename String
  url      String

  userkey String @unique
  user    User   @relation(fields: [userkey], references: [username], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("images")
}

model Project {
  id          String    @id @default(cuid())
  title       String
  description String
  deadline    DateTime
  started_at  DateTime?
  done_at     DateTime?
  delayed     Boolean   @default(false)

  stage    ProjectStage    @default(STARTED) @map("progress")
  priority ProjectPriority @default(MEDIUM)

  orgkey String
  org    Organization @relation(fields: [orgkey], references: [id])

  managerkey String?
  manager    Affiliation? @relation(fields: [managerkey], references: [id], onDelete: SetNull)

  members         Member[]
  comments        Comment[]
  tasks           Task[]
  events          Event[]
  work_logs       TaskWorkLog[]
  stats_snapshots ProjectStatsPeriodSnapshot[]
  stats_reports   ProjectStatsReport[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([delayed, deadline, stage])
  @@map("projects")
}

model Member {
  id String @id @default(cuid())

  projectkey String
  project    Project @relation(fields: [projectkey], references: [id], onDelete: Cascade)

  userkey String
  user    Affiliation @relation(fields: [userkey], references: [id], onDelete: Cascade)

  tasks          Task[]
  comments       Comment[]
  work_logs      TaskWorkLog[]
  period_entries ProjectStatsPeriodTask[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("member")
}

model Task {
  id   String @id @unique @default(cuid())
  code String

  name        String
  description String
  deadline    DateTime
  started_at  DateTime?
  done_at     DateTime?
  delayed     Boolean   @default(false)

  stage    TaskStage    @default(PENDING)
  priority TaskPriority

  projectkey String
  project    Project @relation(fields: [projectkey], references: [id], onDelete: Cascade)

  ownerkey String?
  owner    Member? @relation(fields: [ownerkey], references: [id], onDelete: SetNull)

  work_logs      TaskWorkLog[]
  period_entries ProjectStatsPeriodTask[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([projectkey, code])
  @@index([delayed, deadline, stage])
  @@map("tasks")
}

model Comment {
  id String @id @default(cuid())

  content String
  date    DateTime @default(now())

  ownerkey String?
  owner    Member? @relation(fields: [ownerkey], references: [id], onDelete: SetNull)

  projectkey String
  project    Project @relation(fields: [projectkey], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("comments")
}

model Event {
  id    String   @id @unique @default(cuid())
  title String
  date  DateTime

  projectkey String
  project    Project @relation(fields: [projectkey], references: [id])

  category EventCategory

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("events")
}

model TaskWorkLog {
  id String @id @default(cuid())

  projectkey String
  project    Project @relation(fields: [projectkey], references: [id], onDelete: Cascade)

  taskkey String
  task    Task   @relation(fields: [taskkey], references: [id], onDelete: Cascade)

  memberkey String
  member    Member @relation(fields: [memberkey], references: [id], onDelete: Cascade)

  minutes   Int
  logged_at DateTime
  note      String?
  source    String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([projectkey, logged_at])
  @@index([taskkey, logged_at])
  @@index([memberkey, logged_at])
  @@map("task_work_logs")
}

model ProjectStatsPeriodSnapshot {
  id String @id @default(cuid())

  projectkey String
  project    Project @relation(fields: [projectkey], references: [id], onDelete: Cascade)

  period_type  StatsPeriodType
  period_start DateTime
  period_end   DateTime
  generated_at DateTime        @default(now())
  cutoff_at    DateTime

  performance_per_member_json Json
  productivity_json           Json
  summary_json                Json

  health_status ProjectHealthStatus
  health_score  Int

  period_tasks ProjectStatsPeriodTask[]
  reports      ProjectStatsReport[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([projectkey, period_type, period_start, period_end])
  @@map("project_stats_period_snapshots")
}

model ProjectStatsPeriodTask {
  id String @id @default(cuid())

  snapshotkey String
  snapshot    ProjectStatsPeriodSnapshot @relation(fields: [snapshotkey], references: [id], onDelete: Cascade)

  taskkey String
  task    Task   @relation(fields: [taskkey], references: [id], onDelete: Cascade)

  memberkey String
  member    Member @relation(fields: [memberkey], references: [id], onDelete: Cascade)

  spent_minutes Int
  started_at    DateTime?
  done_at       DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([snapshotkey, taskkey, memberkey])
  @@index([snapshotkey])
  @@index([taskkey])
  @@index([memberkey])
  @@map("project_stats_period_tasks")
}

model ProjectStatsReport {
  id String @id @default(cuid())

  projectkey String
  project    Project @relation(fields: [projectkey], references: [id], onDelete: Cascade)

  generated_at DateTime        @default(now())
  cutoff_at    DateTime
  period_type  StatsPeriodType

  snapshotkey String?
  snapshot    ProjectStatsPeriodSnapshot? @relation(fields: [snapshotkey], references: [id], onDelete: SetNull)

  file_url     String?
  payload_json Json?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([projectkey, generated_at])
  @@index([projectkey, cutoff_at])
  @@map("project_stats_reports")
}

